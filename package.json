{
  "name": "pi-delegate",
  "description": "Multi-agent orchestration harness for pi: spawn delegate workers, collect schema-validated reports.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evreke/delegate.git"
  },
  "version": "1.17.0",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "delegate",
    "herdr",
    "multi-agent"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills/delegate"
    ]
  },
  "exports": {
    ".": "./index.ts",
    "./herdr": "./src/herdr/host.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/bun": "^1.4.2",
    "@types/node": "22",
    "typescript": "7.0.2"
  },
  "files": [
    "index.ts",
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ]
}
